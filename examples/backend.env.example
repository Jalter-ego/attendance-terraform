NODE_ENV=production
PORT=5000
CORS_ORIGIN=*

# Supabase Session pooler (IPv4), with SSL enabled.
DB_SSL=true

DB_READ_HOST=aws-0-us-east-2.pooler.supabase.com
DB_READ_PORT=5432
DB_READ_USERNAME=postgres.YOUR_PROJECT_REF
DB_READ_PASSWORD=
DB_READ_NAME=postgres

DB_WRITE_HOST=aws-0-us-east-2.pooler.supabase.com
DB_WRITE_PORT=5432
DB_WRITE_USERNAME=postgres.YOUR_PROJECT_REF
DB_WRITE_PASSWORD=
DB_WRITE_NAME=postgres

# prepare-env.sh generates a value once in .local/backend.env.
JWT_SECRET=
JWT_EXPIRES_IN=8h
